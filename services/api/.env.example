# LLM provider for chat: gemini (default) or openrouter
# LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# OpenRouter (used when LLM_PROVIDER=openrouter). Key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your-openrouter-api-key
# Image generation reuses GEMINI_API_KEY. Default: gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# NANOBANANA_API_KEY=your-nanobanana-api-key
# NANOBANANA_CALLBACK_URL=https://your-public-url/webhook
# PORT=3001
# CORS_ORIGIN=http://localhost:5173
# Stock Search (Creative agent). Free key: https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key
# Stock Search second provider (optional). Free key: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your-pixabay-api-key
# Weather (Live agent). Optional, free anonymous access works without a key. Key: https://www.visualcrossing.com/sign-up
# VISUALCROSSING_API_KEY=your-visualcrossing-api-key
# Crypto prices (Live agent). Falls back to keyless CoinGecko when unset. Key: https://freecryptoapi.com/panel
# FREECRYPTOAPI_KEY=your-freecryptoapi-key
# Currency rates (Live agent). Optional, falls back to keyless open.er-api.com when unset. Key: https://www.exchangerate-api.com/
# EXCHANGERATE_API_KEY=your-exchangerate-api-key
